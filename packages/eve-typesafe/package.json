{
  "name": "@eve/typesafe",
  "version": "0.0.0",
  "description": "Typed Jev decisions, decision tools, and dynamic model routing for eve.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/eve.git",
    "directory": "packages/eve-typesafe"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "pnpm run build && node ../../scripts/copy-package-license.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:scenario": "vitest run --config vitest.scenario.config.ts"
  },
  "devDependencies": {
    "eve": "workspace:*",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eve": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
